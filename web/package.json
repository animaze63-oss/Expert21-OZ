{
  "name": "experts21-oz-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Web app for talking to the Experts21-OZ agent team. The Claude API is called from a Netlify Function.",
  "scripts": {
    "build:data": "node scripts/build-team-data.mjs",
    "typecheck": "tsc --noEmit -p .",
    "build": "npm run build:data && npm run typecheck && vite build",
    "dev": "npm run build:data && netlify dev",
    "dev:ui": "npm run build:data && vite"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@netlify/functions": "6.1.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  },
  "engines": {
    "node": ">=20"
  }
}
